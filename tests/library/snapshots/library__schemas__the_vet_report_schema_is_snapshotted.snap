      "type": "boolean"
    },
    "project": {
      "$ref": "#/$defs/VetProject"
    },
    "validators": {
      "description": "The project's validator files, in project mode only.",
      "items": {
        "$ref": "#/$defs/VetValidatorFile"
      },
      "type": "array"
    }
  },
  "required": [
    "passed",
    "files"
  ],
  "title": "VetReport",
  "type": "object"
}
