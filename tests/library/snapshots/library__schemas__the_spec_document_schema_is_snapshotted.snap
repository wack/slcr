---
source: tests/library/schemas.rs
expression: "pretty(&schema_of::<SlcrRequirementsDocument>())"
---
{
  "$defs": {
    "AcceptanceCriterion": {
      "additionalProperties": false,
      "description": "A speculative, advisory statement of what done looks like for its\ncontaining requirement. It asserts nothing.",
      "properties": {
        "body": {
          "$ref": "#/$defs/Markdown",
          "description": "May contain a formal sketch in a code block; the engine never reads it."
        },
        "id": {
          "$ref": "#/$defs/AcceptanceCriterionId",
          "description": "The criterion's ID, unique in the specification."
        },
        "kind": {
          "const": "acceptanceCriterion",
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/Title",
          "description": "A short name for the criterion."
        }
      },
      "required": [
        "kind",
        "id",
        "title",
        "body"
      ],
      "type": "object"
    },
    "AcceptanceCriterionId": {
      "description": "An ID of the kind \"acceptance criterion\": `AC-` and then three digits, or four or more without a leading zero, of a number up to 4294967295.",
      "pattern": "^AC-(?:[0-9]{3}|[1-9][0-9]{3,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]|429496729[0-4]|4294967295)$",
      "type": "string"
    },
    "DependencyId": {
      "description": "The ID of a section or a requirement, which a `dependsOn` names: `SEC-` or `REQ-` and then three digits, or four or more without a leading zero, of a number up to 4294967295.",
      "pattern": "^(?:SEC-(?:[0-9]{3}|[1-9][0-9]{3,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]|429496729[0-4]|4294967295)|REQ-(?:[0-9]{3}|[1-9][0-9]{3,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]|429496729[0-4]|4294967295))$",
      "type": "string"
    },
    "FormatVersion": {
      "description": "The version of the serialization format.",
      "enum": [
        "1"
      ],
      "type": "string"
    },
    "Glossary": {
      "additionalProperties": false,
      "description": "The auto-created Glossary Section. It contains every Term and nothing\nelse, and is logically the root's last child.",
      "properties": {
        "body": {
          "$ref": "#/$defs/Markdown",
          "description": "Prose introducing the Glossary."
        },
        "id": {
          "$ref": "#/$defs/SectionId",
          "description": "The Glossary's ID, a section ID unique in the specification."
        },
        "kind": {
          "const": "section",
          "type": "string"
        },
        "terms": {
          "description": "Serialized in ID order; rendered alphabetically by title.",
          "items": {
            "$ref": "#/$defs/Term"
          },
          "minItems": 1,
          "type": "array"
        },
        "title": {
          "$ref": "#/$defs/Title",
          "description": "The Glossary's heading, `Glossary` unless the document renames it."
        }
      },
      "required": [
        "kind",
        "id",
        "title"
      ],
      "type": "object"
    },
    "Markdown": {
      "description": "Non-empty, Markdown-formatted prose: a body, rationale, or definition.",
      "minLength": 1,
      "type": "string"
    },
    "Modality": {
      "description": "An RFC 2119 requirement level.",
      "enum": [
        "MUST",
        "MUST NOT",
        "SHOULD",
        "SHOULD NOT",
        "MAY"
      ],
      "type": "string"
    },
    "Refinement": {
      "description": "How the requirements that refine a requirement combine to satisfy it.",
      "enum": [
        "AND",
        "OR",
        "XOR"
      ],
      "type": "string"
    },
    "Requirement": {
      "additionalProperties": false,
      "description": "A satisfiable statement.",
      "properties": {
        "acceptanceCriteria": {
          "description": "Advisory statements of what done looks like, in order.",
          "items": {
            "$ref": "#/$defs/AcceptanceCriterion"
          },
          "minItems": 1,
          "type": "array"
        },
        "body": {
          "$ref": "#/$defs/Markdown",
          "description": "The primary statement, which should contain the modality keyword."
        },
        "children": {
          "description": "Contained Requirements, in document order. Containment only: a child\nrefines this requirement only if its `refines` says so.",
          "items": {
            "$ref": "#/$defs/Requirement"
          },
          "minItems": 1,
          "type": "array"
        },
        "dependsOn": {
          "description": "Requirements or Sections needed to understand or implement this one.\nContext only; never affects satisfaction.",
          "items": {
            "$ref": "#/$defs/DependencyId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "id": {
          "$ref": "#/$defs/RequirementId",
          "description": "The requirement's ID, unique in the specification."
        },
        "kind": {
          "const": "requirement",
          "type": "string"
        },
        "modality": {
          "$ref": "#/$defs/Modality",
          "description": "The requirement level of the statement."
        },
        "rationale": {
          "$ref": "#/$defs/Markdown",
          "description": "Why the requirement exists."
        },
        "refinement": {
          "$ref": "#/$defs/Refinement",
          "description": "How the requirements that refine this one combine. Present exactly\nwhen at least one requirement refines this one."
        },
        "refines": {
          "description": "Requirements this one helps satisfy. Always explicit: nesting never\nimplies refinement.",
          "items": {
            "$ref": "#/$defs/RequirementId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "title": {
          "$ref": "#/$defs/Title",
          "description": "A short name for the requirement."
        },
        "usesTerm": {
          "description": "Terms whose definitions this node's slice pulls in.",
          "items": {
            "$ref": "#/$defs/TermId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "id",
        "title",
        "body",
        "modality"
      ],
      "type": "object"
    },
    "RequirementId": {
      "description": "An ID of the kind \"requirement\": `REQ-` and then three digits, or four or more without a leading zero, of a number up to 4294967295.",
      "pattern": "^REQ-(?:[0-9]{3}|[1-9][0-9]{3,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]|429496729[0-4]|4294967295)$",
      "type": "string"
    },
    "Section": {
      "additionalProperties": false,
      "description": "Document structure and freeform prose: preambles, background, and\nmotivation. A Section groups other nodes and has no satisfaction value.",
      "properties": {
        "body": {
          "$ref": "#/$defs/Markdown",
          "description": "Prose introducing the section."
        },
        "children": {
          "description": "Contained Sections and Requirements, in document order.",
          "items": {
            "$ref": "#/$defs/SectionChild"
          },
          "minItems": 1,
          "type": "array"
        },
        "id": {
          "$ref": "#/$defs/SectionId",
          "description": "The section's ID, unique in the specification."
        },
        "kind": {
          "const": "section",
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/Title",
          "description": "The heading of the section."
        },
        "usesTerm": {
          "description": "Terms whose definitions this node's slice pulls in.",
          "items": {
            "$ref": "#/$defs/TermId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "id",
        "title"
      ],
      "type": "object"
    },
    "SectionChild": {
      "anyOf": [
        {
          "$ref": "#/$defs/Section"
        },
        {
          "$ref": "#/$defs/Requirement"
        }
      ],
      "description": "A node contained by a section: a section or a requirement, told apart by its `kind`."
    },
    "SectionId": {
      "description": "An ID of the kind \"section\": `SEC-` and then three digits, or four or more without a leading zero, of a number up to 4294967295.",
      "pattern": "^SEC-(?:[0-9]{3}|[1-9][0-9]{3,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]|429496729[0-4]|4294967295)$",
      "type": "string"
    },
    "SpecMetadata": {
      "additionalProperties": false,
      "description": "Facts about the specification as a whole.",
      "properties": {
        "name": {
          "$ref": "#/$defs/SpecName",
          "description": "The qualifier in references such as `todo-api/REQ-002`."
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "SpecName": {
      "description": "A specification's name: lowercase ASCII letters and digits in dash-separated words.",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "Term": {
      "additionalProperties": false,
      "description": "A glossary entry.",
      "properties": {
        "aliases": {
          "description": "Other names for the term.",
          "items": {
            "$ref": "#/$defs/Title"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "definition": {
          "$ref": "#/$defs/Markdown",
          "description": "What the term means."
        },
        "id": {
          "$ref": "#/$defs/TermId",
          "description": "The term's ID, unique in the specification."
        },
        "kind": {
          "const": "term",
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/Title",
          "description": "The term as the specification names it."
        }
      },
      "required": [
        "kind",
        "id",
        "title",
        "definition"
      ],
      "type": "object"
    },
    "TermId": {
      "description": "An ID of the kind \"term\": `TERM-` and then three digits, or four or more without a leading zero, of a number up to 4294967295.",
      "pattern": "^TERM-(?:[0-9]{3}|[1-9][0-9]{3,8}|[1-3][0-9]{9}|4[0-1][0-9]{8}|42[0-8][0-9]{7}|429[0-3][0-9]{6}|4294[0-8][0-9]{5}|42949[0-5][0-9]{4}|429496[0-6][0-9]{3}|4294967[0-1][0-9]{2}|42949672[0-8][0-9]|429496729[0-4]|4294967295)$",
      "type": "string"
    },
    "Title": {
      "description": "A node's human-facing name: a single line with no leading or trailing whitespace.",
      "pattern": "^\\S(?:[^\\r\\n]*\\S)?$",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "One SLCR specification: a requirements document, stored as a graph. The `root` section holds a tree of sections and requirements in sibling order, and the `glossary` holds the terms. The cross edges `refines`, `dependsOn`, and `usesTerm` are ID references held on their source node. The schema describes the grammar of a document; the invariants it can't express (every reference names a node that exists, `refines` and `dependsOn` form no cycle, each requirement has a `refinement` exactly when another requirement refines it) are checked by vetting.",
  "properties": {
    "$schema": {
      "description": "The JSON Schema this document claims to conform to.",
      "type": "string"
    },
    "formatVersion": {
      "$ref": "#/$defs/FormatVersion",
      "description": "The version of the serialization format, not of the specification's\ncontent."
    },
    "glossary": {
      "$ref": "#/$defs/Glossary",
      "description": "Logically the root's last child, held apart because it is fixed and\ncontains only Terms."
    },
    "root": {
      "$ref": "#/$defs/Section",
      "description": "The top of the containment tree."
    },
    "spec": {
      "$ref": "#/$defs/SpecMetadata",
      "description": "Facts about the specification as a whole."
    }
  },
  "required": [
    "formatVersion",
    "spec",
    "root",
    "glossary"
  ],
  "title": "SpecDocument",
  "type": "object"
}
